{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "skipLibCheck": true,
    // Nuxt UI's component types import their theme from `#build/ui/*`, which its Vite plugin generates.
    // `bun run ui:prepare` (the playground build) writes them; `typecheck` runs it first.
    "paths": {
      "#build/ui": ["./node_modules/.nuxt-ui/ui"],
      "#build/ui/*": ["./node_modules/.nuxt-ui/ui/*"]
    },
    "noEmit": true
  },
  "vueCompilerOptions": {
    "strictTemplates": true
  },
  "include": ["src", "playground"]
}
