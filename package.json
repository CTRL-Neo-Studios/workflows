{
  "name": "@type32/workflows",
  "version": "0.1.3",
  "description": "Workflows Scripting Engine",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./core": "./dist/core/index.mjs",
    "./core/std": "./dist/core/std/index.mjs",
    "./core/testing": "./dist/core/testing/index.mjs",
    "./vue": "./dist/vue/index.mjs",
    "./vue/style.css": "./dist/vue/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "play": "vite playground",
    "ui:prepare": "vite build playground --outDir ../node_modules/.cache/playground --emptyOutDir --logLevel warn",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "bun run ui:prepare && vue-tsc --noEmit && node node_modules/typescript7/bin/tsc -p tsconfig.core.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test",
    "changeset": "changeset",
    "release": "bun run build && changeset publish",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@iconify-json/lucide": "^1.2.150",
    "@nuxt/ui": "^4.12.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue-flow/core": "^1.48.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4",
    "tsdown": "^0.23.4",
    "typescript": "6.0.3",
    "typescript7": "npm:typescript@^7.0.2",
    "unplugin-vue": "^8.0.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.14"
  },
  "peerDependencies": {
    "@nuxt/ui": "^4.12.0",
    "@vue-flow/core": "^1.48.2",
    "typescript": ">=6.0.3",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/ui": {
      "optional": true
    },
    "@vue-flow/core": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19"
  }
}
